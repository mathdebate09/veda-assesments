# MongoDB
MONGODB_URI=

# Azure Blob Storage
# IMPORTANT: Paste the FULL connection string from Azure Portal > Storage Account > Access Keys
# Format: DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT_NAME;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONNECTION_STRING=
# Paste ONLY the storage account name (e.g. vedastorageaccount) — NOT the key
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER=

# DeepSeek
DEEPSEEK_API_KEY=

# App
JWT_SECRET=some-random-string
PORT=3000